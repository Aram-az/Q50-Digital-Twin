# Copy to .env for local development. NEVER commit .env.
# Default: SQLite file. Quick start works without Docker.
Q50_DATABASE_URL=sqlite+pysqlite:///./data/q50-local.db

# PostgreSQL option after: docker compose up -d db
# Change Q50_DATABASE_URL above to:
# Q50_DATABASE_URL=postgresql+psycopg://q50dev:q50_dev_only@127.0.0.1:5433/q50digitaltwin
